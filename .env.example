PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
APP_BASE_URL=http://localhost:3000

# Email mode: mock or smtp
EMAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
EMAIL_FROM="CEL Support <your-email@gmail.com>"

# Seeded admin account (change before first production deployment)
ADMIN_NAME=CEL Administrator
ADMIN_EMAIL=admin@cel.local
ADMIN_PASSWORD=Admin@12345

# Secret code new staff must enter at registration to sign up as an admin.
# Leave blank to disable self-serve admin registration entirely.
ADMIN_SIGNUP_CODE=change-this-to-a-secret-only-staff-know
